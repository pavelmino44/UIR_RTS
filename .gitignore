# ==========================================
# Виртуальные окружения (Python)
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# Байт-код Python и кэш
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Результаты работы скриптов (графики, анимации)
# ==========================================
# Если вы НЕ хотите коммитить сгенерированные графики, оставьте эти строки.
# Если графики нужны в репозитории (например, для отчета), закомментируйте их (#).
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.avi

# Исключение: если какие-то картинки - это исходные данные, 
# а не сгенерированные результаты, их можно принудительно добавить так:
# !source_image.png

